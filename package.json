{
  "name": "comment-v2",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "test:e2e": "docker compose up -d --build && pnpm --filter @comment/service test:e2e",
    "dev:service": "pnpm --filter @comment/service dev",
    "dev:console": "pnpm --filter @comment/console dev",
    "dev:lab": "pnpm --filter @comment/developer-lab dev",
    "local:up": "docker compose up --build",
    "local:down": "docker compose down",
    "local:reset": "docker compose down -v && docker compose up --build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}